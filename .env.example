# Copy this file to .env and fill in your real values.
# .env is already in .gitignore — it will never be committed.
# NEVER put real secrets directly in docker-compose.yaml.

# --- Source / Warehouse database (e.g. Neon) ---
NEON_CONN_STRING=postgresql+psycopg2://<user>:<password>@<host>/<db>?sslmode=require

# --- SMTP (used by on_failure_callback email alerts) ---
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_MAIL_FROM=your_email@example.com

# --- Airflow admin user (created once by airflow-init) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_before_first_run
AIRFLOW_ADMIN_EMAIL=your_email@example.com
AIRFLOW_ADMIN_FIRSTNAME=Mo
AIRFLOW_ADMIN_LASTNAME=Amer

# --- Airflow webserver secret key (generate your own random string) ---
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=generate_a_long_random_string_here
